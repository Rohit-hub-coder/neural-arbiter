# Neural Arbiter Configuration

# Toggle Simulation / Mock Mode:
# Set TEST_MODE=true for interactive demo mode (runs offline without API keys)
# Set TEST_MODE=false to use live LLMs (requires API keys below or entered via UI)
TEST_MODE=true

# Live LLM API Keys (Required only if TEST_MODE=false)
GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
